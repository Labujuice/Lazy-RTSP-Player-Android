<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Primary Video SurfaceView (Zero-Copy to ANativeWindow) -->
    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Control Bar (Translucent) -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/control_bar_bg"
        android:padding="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/default_rtsp_url"
            android:textColorHint="#FFAAAAAA"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:background="#33FFFFFF"
            android:padding="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="@string/history"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_blue"
            android:focusable="true" />

        <Button
            android:id="@+id/btnPlayStop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="@string/connect"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_green"
            android:focusable="true" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="@string/record"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF4B5563"
            android:focusable="true" />

        <Button
            android:id="@+id/btnSnapshot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="@string/snapshot"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF4B5563"
            android:focusable="true" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="@string/settings"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF374151"
            android:focusable="true" />
    </LinearLayout>

    <!-- 500ms Disconnection Warning Badge (Top-Center) -->
    <TextView
        android:id="@+id/tvDisconnectionWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="@string/disconnection_warning"
        android:textColor="@color/amber_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@color/amber_warning"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Non-intrusive OSD Telemetry HUD (Top-Right, Monospace) -->
    <ScrollView
        android:id="@+id/osdContainer"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:background="@color/osd_background"
        android:padding="8dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvOsdContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/osd_text"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"
            android:text="TELEMETRY INITIALIZING..." />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
